// Development Environment Configuration
// UsersApp Development Settings

// App Configuration
APP_NAME = UsersApp Dev
BUNDLE_IDENTIFIER = com.oguztandogan.usersapp.dev
PRODUCT_NAME = $(APP_NAME)
PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_IDENTIFIER)

// API Configuration
API_TIMEOUT = 30

// Build Configuration
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) DEV=1 DEBUG=1
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) DEV DEBUG

// App Icon
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon-Dev

// Bundle Version
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

// Info.plist
INFOPLIST_FILE = UsersApp/Configuration/Plist/Info-Dev.plist
INFOPLIST_KEY_CFBundleDisplayName = $(APP_NAME)

// Development specific settings
ENABLE_TESTABILITY = YES
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
