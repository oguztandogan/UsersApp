// QA Environment Configuration
// UsersApp QA Settings

// App Configuration
APP_NAME = UsersAppQA
BUNDLE_IDENTIFIER = com.oguztandogan.usersapp.qa
PRODUCT_NAME = $(APP_NAME)
PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_IDENTIFIER)

// API Configuration
API_TIMEOUT = 20

// Build Configuration
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) QA=1 DEBUG=1
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) QA DEBUG

// App Icon
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon-QA

// Bundle Version
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

// Info.plist
INFOPLIST_FILE = UsersApp/Configuration/Plist/Info-QA.plist
INFOPLIST_KEY_CFBundleDisplayName = $(APP_NAME)

// QA specific settings
ENABLE_TESTABILITY = YES
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
